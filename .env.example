NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://smart_roommate:local_dev_password@localhost:5432/smart_roommate
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_roommate
DB_USER=smart_roommate
DB_PASSWORD=local_dev_password
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-another-32-character-secret
REFRESH_TOKEN_EXPIRES_IN=7d
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=room-images
MESSAGING_PROVIDER=local
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE=smart-roommate-events
REALTIME_PROVIDER=socketio
AZURE_WEB_PUBSUB_CONNECTION_STRING=
AZURE_WEB_PUBSUB_HUB=smart_roommate
MATCHING_PROVIDER=rule-based
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
CACHE_PROVIDER=memory
AZURE_REDIS_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
